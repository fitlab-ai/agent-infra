{
  "skill": "review-analysis",
  "checks": {
    "task-meta": {
      "required_fields": [
        "id",
        "type",
        "workflow",
        "status",
        "created_at",
        "updated_at",
        "agent_infra_version",
        "current_step",
        "assigned_to"
      ],
      "expected_step": "requirement-analysis-review"
    },
    "artifact": {
      "file_pattern": "review-analysis.md|review-analysis-r{N}.md",
      "schema": "review-analysis"
    },
    "decision-details": {},
    "review-summary": {
      "stage": "analysis"
    },
    "activity-log": {
    },
    "platform-sync": {
      "when": "platform_issue_identity_exists"
    }
  }
}
