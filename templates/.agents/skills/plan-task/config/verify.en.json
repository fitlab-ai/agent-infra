{
  "skill": "plan-task",
  "checks": {
    "task-meta": {
      "required_fields": [
        "id",
        "type",
        "workflow",
        "status",
        "created_at",
        "updated_at",
        "agent_infra_version",
        "current_step",
        "assigned_to"
      ],
      "expected_step": "technical-design"
    },
    "artifact": {
      "file_pattern": "plan.md|plan-r{N}.md",
      "schema": "plan"
    },
    "activity-log": {
      "expected_action_pattern": "(Plan Task|Technical Design) \\(Round \\d+\\)"
    },
    "review-ledger": {
      "stage_scope": [
        "analysis"
      ]
    },
    "platform-sync": {
      "when": "platform_issue_identity_exists"
    }
  }
}
