{
  "skill": "review-plan",
  "checks": {
    "task-meta": {
      "required_fields": [
        "id",
        "type",
        "workflow",
        "status",
        "created_at",
        "updated_at",
        "agent_infra_version",
        "current_step",
        "assigned_to"
      ],
      "expected_step": "technical-design-review"
    },
    "artifact": {
      "file_pattern": "review-plan.md|review-plan-r{N}.md",
      "schema": "review-plan"
    },
    "decision-details": {},
    "review-summary": {
      "stage": "plan"
    },
    "activity-log": {
      "expected_action_pattern": "(Review Plan|Plan Review) \\(Round \\d+\\)"
    },
    "platform-sync": {
      "when": "platform_issue_identity_exists"
    }
  }
}
