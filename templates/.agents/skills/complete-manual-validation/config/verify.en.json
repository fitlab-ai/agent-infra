{
  "skill": "complete-manual-validation",
  "checks": {
    "task-meta": {
      "required_fields": [
        "id",
        "type",
        "workflow",
        "status",
        "created_at",
        "updated_at",
        "agent_infra_version",
        "current_step",
        "assigned_to"
      ]
    },
    "artifact": {
      "file_pattern": "manual-validation.md|manual-validation-r{N}.md",
      "required_sections": [
        "State Check",
        "Validation Verdict",
        "Validation Scope",
        "Validation Details",
        "PR Summary Sync"
      ],
      "required_patterns": [
        "^\\$ "
      ]
    },
    "activity-log": {
      "expected_action_pattern": "Complete Manual Validation"
    },
    "review-ledger": {
      "stage_scope": [
        "analysis",
        "plan",
        "code"
      ]
    },
    "platform-sync": {
      "when": "pr_fact_bound",
      "expected_pr_comment_required_patterns": [
        "^### ✅ (?:人工验证已通过|Manual Validation Passed)$"
      ]
    }
  }
}
