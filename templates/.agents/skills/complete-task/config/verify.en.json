{
  "skill": "complete-task",
  "checks": {
    "task-meta": {
      "required_fields": [
        "id",
        "type",
        "workflow",
        "status",
        "created_at",
        "updated_at",
        "agent_infra_version",
        "current_step",
        "assigned_to",
        "completed_at"
      ],
      "expected_status": "completed",
      "require_completed_at": true
    },
    "activity-log": {
      "expected_action_pattern": "(Complete Task|Completed)"
    },
    "completion-checklist": {
      "require_all_checked": true
    },
    "review-ledger": {},
    "manual-validation": {},
    "post-review-commit": {},
    "platform-sync-preflight": {
      "when": "platform_issue_identity_exists"
    },
    "required-pr-delivery": {},
    "platform-sync": {
      "when": "platform_issue_identity_exists"
    },
    "artifact": {
      "file_pattern": "task.md",
      "required_sections": [
        "State Check"
      ],
      "required_patterns": [
        "^\\$ "
      ]
    }
  }
}
