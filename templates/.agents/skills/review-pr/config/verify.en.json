{
  "skill": "review-pr",
  "checks": {
    "artifact": {
      "file_pattern": "pr-review.md|pr-review-r{N}.md",
      "required_sections": [
        "Identity",
        "Evidence List",
        "Coverage Matrix",
        "Findings",
        "Publication Result",
        "State Check",
        "Evidence"
      ],
      "required_patterns": [
        "^\\$ ",
        "^- \\*\\*Reviewed Head SHA\\*\\*[:：]\\s*[0-9a-f]{40}\\s*$",
        "^- \\*\\*Review Mode\\*\\*[:：]\\s*(?:verify|audit|reconstruct)\\s*$",
        "^- \\*\\*Evidence Scenario\\*\\*[:：]\\s*S[123]\\s*$",
        "^- \\*\\*receipt\\*\\*[:：]\\s*\\S"
      ]
    },
    "activity-log": {
      "expected_action_pattern": "Review PR \\(Round \\d+\\)"
    },
    "platform-sync": {
      "when": "issue_number_exists",
      "expected_comment_marker": "<!-- sync-issue:{task-id}:{artifact-stem} -->",
      "verify_comment_content": true,
      "verify_task_comment_content": true,
      "verify_issue_type": false,
      "verify_issue_fields": false,
      "verify_milestone": false,
      "expected_comment_marker_key": "artifact"
    }
  }
}
