{
  "skill": "review-pr",
  "checks": {
    "artifact": {
      "file_pattern": "pr-review.md|pr-review-r{N}.md",
      "required_sections": [
        "Identity",
        "Evidence List",
        "Coverage Matrix",
        "Findings",
        "Publication Result",
        "State Check",
        "Evidence"
      ],
      "state_check_patterns": [
        "agent-infra-internal[ \\t]+task-snapshot\\b"
      ],
      "required_patterns": [
        "^- \\*\\*Reviewed Head SHA\\*\\*[:：]\\s*[0-9a-f]{40}\\s*$",
        "^- \\*\\*Review Mode\\*\\*[:：]\\s*(?:verify|audit|reconstruct)\\s*$",
        "^- \\*\\*Evidence Scenario\\*\\*[:：]\\s*S[123]\\s*$",
        "^- \\*\\*receipt\\*\\*[:：]\\s*\\S"
      ]
    },
    "activity-log": {
      "expected_action_pattern": "Review PR \\(Round \\d+\\)"
    },
    "platform-sync": {
      "when": "platform_issue_identity_exists"
    }
  }
}
