{
  "skill": "run-manual-validation",
  "checks": {
    "task-meta": {
      "required_fields": [
        "id",
        "type",
        "workflow",
        "status",
        "created_at",
        "updated_at",
        "agent_infra_version",
        "current_step",
        "assigned_to"
      ]
    },
    "artifact": {
      "file_pattern": "validation-run.md|validation-run-r{N}.md",
      "required_sections": [
        "Input Mode",
        "State Check",
        "Validation Target",
        "Discovered Items",
        "Mode Decision",
        "Command Summary",
        "Structured Evidence",
        "Per-item Results",
        "Cleanup and Recovery",
        "Remaining Coverage",
        "Raw Evidence"
      ],
      "state_check_patterns": [
        "agent-infra-internal[ \\t]+task-snapshot\\b"
      ]
    },
    "activity-log": {
      "expected_action_pattern": "Run Manual Validation \\(Round \\d+\\)"
    },
    "review-ledger": {
      "stage_scope": [
        "analysis",
        "plan",
        "code"
      ]
    },
    "platform-sync": {
      "when": "platform_issue_identity_exists"
    }
  }
}
