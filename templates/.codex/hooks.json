{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.agents/hooks/check-version-format.sh\"",
            "timeout": 5,
            "statusMessage": "Checking template version before git commit"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^agent-infra-lifecycle-(executor|reviewer)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/lifecycle-delegation.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^agent-infra-lifecycle-(executor|reviewer)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/lifecycle-delegation.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
