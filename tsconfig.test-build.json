{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": false,
    "outDir": "./dist",
    "sourceMap": true
  },
  "include": [
    "bin/**/*.ts",
    "lib/**/*.ts",
    "scripts/**/*.js",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests/fixtures",
    "templates",
    "src",
    ".agents",
    "dist"
  ]
}
