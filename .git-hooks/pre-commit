#!/bin/sh
set -e

script_dir=$(
  CDPATH= cd -- "$(dirname -- "$0")" && pwd
)

"$script_dir/check-utf8-encoding.sh"
"$script_dir/check-version-format.sh"
node "$script_dir/check-large-files.cjs"

# Fail fast on TypeScript errors.
# typecheck covers tests/ + scripts/ which the production `build` step skips.
npm run typecheck

# Guard against drift between the authoritative src/sync-templates.js
# (+ lib/defaults.json) and its two build-inline-generated copies. Mirrors the CI
# pre-Build check.
node scripts/build-inline.js --check
