{
  "skill": "code-task",
  "checks": {
    "task-meta": {
      "required_fields": [
        "id",
        "type",
        "workflow",
        "status",
        "created_at",
        "updated_at",
        "agent_infra_version",
        "current_step",
        "assigned_to"
      ],
      "expected_step": "code"
    },
    "artifact": {
      "file_pattern": "code.md|code-r{N}.md",
      "schema": "code"
    },
    "implementation-input": {},
    "activity-log": {
    },
    "review-ledger": {
      "stage_scope": [
        "analysis",
        "plan"
      ]
    },
    "platform-sync": {
      "when": "platform_issue_identity_exists"
    }
  }
}
