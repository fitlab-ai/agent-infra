{
  "skill": "review-code",
  "checks": {
    "task-meta": {
      "required_fields": [
        "id",
        "type",
        "workflow",
        "status",
        "created_at",
        "updated_at",
        "agent_infra_version",
        "current_step",
        "assigned_to"
      ],
      "expected_step": "code-review"
    },
    "artifact": {
      "file_pattern": "review-code.md|review-code-r{N}.md",
      "schema": "review-code"
    },
    "decision-details": {},
    "review-summary": {
      "stage": "code"
    },
    "review-fact": {},
    "activity-log": {
      "expected_action_pattern": "(Review Code|Code Review) \\(Round \\d+\\)"
    },
    "platform-sync": {
      "when": "platform_issue_identity_exists",
      "expected_status_label": "status: in-progress",
      "expected_comment_marker": "<!-- sync-issue:{task-id}:{artifact-stem} -->",
      "verify_comment_content": true,
      "verify_task_comment_content": true,
      "verify_issue_type": true,
      "verify_issue_fields": false,
      "verify_milestone": true,
      "expected_status_label_key": "inProgress",
      "expected_comment_marker_key": "artifact"
    }
  }
}
