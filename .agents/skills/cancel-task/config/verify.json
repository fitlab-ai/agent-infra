{
  "skill": "cancel-task",
  "checks": {
    "task-meta": {
      "required_fields": [
        "id",
        "type",
        "workflow",
        "status",
        "created_at",
        "updated_at",
        "agent_infra_version",
        "current_step",
        "assigned_to",
        "cancelled_at",
        "cancel_reason"
      ],
      "expected_status": "completed",
      "require_cancelled_at": true
    },
    "activity-log": {
    },
    "platform-sync": {
      "when": "platform_issue_identity_exists"
    }
  }
}
