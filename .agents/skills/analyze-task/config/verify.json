{
  "skill": "analyze-task",
  "checks": {
    "task-meta": {
      "required_fields": [
        "id",
        "type",
        "workflow",
        "status",
        "created_at",
        "updated_at",
        "agent_infra_version",
        "current_step",
        "assigned_to"
      ],
      "expected_step": "requirement-analysis",
      "require_start_date": true
    },
    "artifact": {
      "file_pattern": "analysis.md|analysis-r{N}.md",
      "schema": "analysis"
    },
    "activity-log": {
      "expected_action_pattern": "(Analyze Task|Requirement Analysis) \\(Round \\d+\\)"
    },
    "platform-sync": {
      "when": "platform_issue_identity_exists"
    }
  }
}
