      ".gemini/commands/",
      ".git-hooks/check-large-files.cjs",
      ".git-hooks/check-version-format.sh",
      ".github/scripts/",
      ".opencode/commands/",
      ".github/workflows/metadata-sync.yml",
      ".github/workflows/pr-label.yml",
      ".github/workflows/status-label.yml"
    ],
    "merged": [
      "**/post-release.*",
