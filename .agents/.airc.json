      ".opencode/README.md",
      "AGENTS.md"
    ],
    "ejected": [
      ".agents/rules/cross-platform-tests.md",
      ".github/scripts/generate-bottle-block.mjs"
    ],
    "managedBaselines": {
      ".github/workflows/metadata-sync.yml": "sha256:6372ce9f924220ec6042c48d4ea9148aadc48878c67c63e1e21ab073417774d2",
      ".github/workflows/pr-label.yml": "sha256:8438d56392b63fe365d487b586bb2b242eb142dc3bbd24dd631e18b60e2e0a89",
